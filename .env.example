# ---------------------------------------------------------------- aplicação
APP_ENV=development
# Gere com: python -m app.cli gen-keys
APP_SECRET_KEY=
APP_ENCRYPTION_KEY=
APP_SESSION_HOURS=12
# Em produção (HTTPS): true
APP_COOKIE_SECURE=false
APP_PUBLIC_BASE_URL=http://localhost:8000
APP_DEFAULT_TENANT=dfj
# Envia o pedido ao Bling logo após criar (em background). Com false, use o cron process-jobs.
APP_PROCESS_JOBS_INLINE=true

# ---------------------------------------------------------------- banco
# Local: SQLite. Produção: postgresql+psycopg://usuario:senha@host:5432/portal
DATABASE_URL=sqlite:///./portal.db

# ---------------------------------------------------------------- seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Só para --demo (cria vendedor@demo.local e pdv@demo.local)
SEED_DEMO_PASSWORD=

# ---------------------------------------------------------------- Bling (OAuth v3)
# Cada conexão ERP guarda só o PREFIXO; os segredos ficam aqui, no servidor.
# Conta ST Nicolas (base técnica / validação):
BLING_STNICOLAS_CLIENT_ID=
BLING_STNICOLAS_CLIENT_SECRET=
# Conta DFJ (quando existir):
BLING_DFJ_CLIENT_ID=
BLING_DFJ_CLIENT_SECRET=
# Precisa ser idêntico ao "Link de redirecionamento" do app no Bling:
# BLING_REDIRECT_URI=http://localhost:8000/api/admin/erp/oauth/callback
# Ajustes avançados (padrões já corretos):
# BLING_API_BASE=https://api.bling.com.br/Api/v3
# BLING_OAUTH_AUTHORIZE_URL=https://www.bling.com.br/Api/v3/oauth/authorize
# BLING_OAUTH_TOKEN_URL=https://api.bling.com.br/Api/v3/oauth/token
# BLING_MIN_INTERVAL_S=0.35
